# Пример конфигурации. Скопируйте в .env и подставьте свои значения:
#   Copy-Item .env.example .env
# Файл .env содержит секреты и НЕ должен попадать в git.

# ---------------------------------------------------------------- PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_supply_list
DB_USER=postgres
DB_PASSWORD=

# Пул соединений
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_THREAD_POOL_SIZE=16
RUN_MIGRATIONS_ON_STARTUP=true

# ----------------------------------------------------------------------- JWT
# Сгенерировать новый секрет (минимум 32 символа):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=8
PBKDF2_ITERATIONS=600000

# ------------------------------------------------------------ FastAPI/Uvicorn
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
UVICORN_RELOAD=true
# true только если приложение стоит за доверенным reverse-proxy
TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------- Лимиты
MAX_BODY_BYTES=1048576
RATE_LIMIT_WINDOW=60
RATE_LIMIT_REQUESTS=120
AUTH_RATE_LIMIT_REQUESTS=10
MAX_LISTS_PER_USER=200
MAX_ITEMS_PER_LIST=1000
MAX_MEMBERS_PER_LIST=50

# --------------------------------------------------------------------- CORS
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------------------------- Подсказки
# false — подсказки выключены для всех пользователей
AI_SUGGESTIONS_ENABLED=true
# statistical — табличный движок (product_pair_rules).
# Значения llm/hybrid оставлены для совместимости и ведут себя как statistical.
SUGGESTIONS_PROVIDER=statistical
SUGGESTIONS_DEFAULT_LIMIT=5
SUGGESTIONS_MAX_LIMIT=20
SUGGESTIONS_CACHE_TTL_SECONDS=86400
SUGGESTIONS_MIN_SCORE=0.05

# --------------------------------------------------------------------- Тесты
# База для pytest (создается и удаляется автоматически)
TEST_DB_NAME=smart_supply_list_test
